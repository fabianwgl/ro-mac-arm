# Turns the dump program records into the Swift golden file.
#
# Inputs, in this order (see generate.sh):
#   1. dump records (@pkt, @hdr, @size, @blob lines, tab separated)
#   2. client HEADER_* names, one per line
#   3. client struct names that have a static `size`, one per line
#   4. normalized hex literals found in rAthena sources, one per line (0x1a2)
#   5. HEADER_* names referenced by rAthena sources, one per line
#   6. packet name hints from rAthena comments, "<hex opcode without 0x><TAB><NAME>" per line
#
# Variables: commit, packetver, files (the five file names, space separated).
#
# GPL-3.0, derived from rAthena.

function hex(n) { return sprintf("0x%x", n) }

# " HEADER_<hint>" when a comment names the opcode, "" otherwise. Does not create array entries.
function hint_name(opcode,    key) {
	key = hex(opcode)
	return (key in hint_by_hex) ? " HEADER_" hint_by_hex[key] : ""
}

function fail(message) {
	print "emit_swift.awk: " message > "/dev/stderr"
	failed = 1
	exit 1
}

function direction_of(opcode, function_name,    list, count, i, c2s, s2c, name) {
	if (function_name != "-") {
		return ".clientToServer"
	}
	c2s = 0
	s2c = 0
	count = split(names_by_opcode[opcode] hint_name(opcode), list, " ")
	for (i = 1; i <= count; i++) {
		name = list[i]
		if (name ~ /^HEADER_(CZ|CA|CH|CT|CS)_/) c2s = 1
		if (name ~ /^HEADER_(ZC|AC|HC|SC|TC)_/) s2c = 1
	}
	if (c2s && !s2c) return ".clientToServer"
	if (s2c && !c2s) return ".serverToClient"
	return ".unknown"
}

BEGIN {
	FS = "\t"
	split(files, file_list, " ")
}

FILENAME == file_list[1] {
	if ($1 == "@pkt") {
		packet_count++
		p_opcode[packet_count] = $2 + 0
		p_length[packet_count] = $3 + 0
		p_function[packet_count] = $4
		p_offsets[packet_count] = $5
		p_latest[packet_count] = $6
		p_expression[packet_count] = $7
	} else if ($1 == "@hdr") {
		if (($2 in header_value) && header_value[$2] != $3 + 0) {
			fail("conflicting values for " $2)
		}
		if (!($2 in header_value)) {
			header_names[++header_count] = $2
			names_by_opcode[$3 + 0] = names_by_opcode[$3 + 0] " " $2
		}
		header_value[$2] = $3 + 0
	} else if ($1 == "@size") {
		if (!($2 in struct_size)) {
			struct_count++
		}
		struct_size[$2] = $3 + 0
	} else if ($1 == "@blob") {
		blob_count++
		b_name[blob_count] = $2
		b_hex[blob_count] = $3
		b_layout[blob_count] = $4
	} else {
		fail("unknown record " $1)
	}
	next
}

FILENAME == file_list[2] { if ($0 != "") client_headers[++client_header_count] = $0; next }
FILENAME == file_list[3] { if ($0 != "") client_structs[++client_struct_count] = $0; next }
FILENAME == file_list[4] { if ($0 != "") literal_seen[$0] = 1; next }
FILENAME == file_list[5] { if ($0 != "") header_referenced[$0] = 1; next }
FILENAME == file_list[6] { if ($1 != "" && !(("0x" $1) in hint_by_hex)) hint_by_hex["0x" $1] = $2; next }

# Simple insertion sort, arrays here are at most a few thousand entries and awk has no sort.
function sort_names(arr, n,    i, j, tmp) {
	for (i = 2; i <= n; i++) {
		tmp = arr[i]
		for (j = i - 1; j >= 1 && arr[j] > tmp; j--) {
			arr[j + 1] = arr[j]
		}
		arr[j + 1] = tmp
	}
}

END {
	if (failed) exit 1

	print "//"
	print "//  RathenaGolden20211103.swift"
	print "//  RagnarokPacketsTests"
	print "//"
	print "//  GENERATED by Tools/packet-golden/generate.sh. DO NOT EDIT."
	print "//"
	print "//  Source: rAthena commit " commit ", PACKETVER " packetver "."
	print "//  License: GPL-3.0, derived from rAthena (https://github.com/rathena/rathena)."
	print "//"
	print ""
	print "@testable import RagnarokPackets"
	print ""
	print "enum RathenaGolden20211103 {"
	print "    static let commit = \"" commit "\""
	print "    static let packetVersion = " packetver
	print ""
	print "    enum Direction: String {"
	print "        case clientToServer = \"C2S\""
	print "        case serverToClient = \"S2C\""
	print "        case unknown = \"?\""
	print "    }"
	print ""
	print "    struct PacketEntry {"
	print "        /// Packet type."
	print "        let opcode: Int"
	print "        /// Length as registered in clif_packetdb.hpp, -1 for variable length."
	print "        let length: Int"
	print "        let direction: Direction"
	print "        /// Parse function. Only packets rAthena parses (client to server) have one."
	print "        let function: String?"
	print "        let offsets: [Int]"
	print "        /// False when a newer opcode is registered for the same parse function."
	print "        let isCurrent: Bool"
	print "    }"
	print ""
	print "    private static func e(_ opcode: Int, _ length: Int, _ direction: Direction, _ function: String? = nil, _ offsets: [Int] = [], current: Bool = true) -> PacketEntry {"
	print "        PacketEntry(opcode: opcode, length: length, direction: direction, function: function, offsets: offsets, isCurrent: current)"
	print "    }"
	print ""

	# --- packet table
	print "    /// Every packet in clif_packetdb.hpp at PACKETVER " packetver ", ordered by opcode."
	print "    static let packets: [PacketEntry] = ["
	for (i = 1; i <= packet_count; i++) {
		line = sprintf("        e(0x%04x, %d, %s", p_opcode[i], p_length[i], direction_of(p_opcode[i], p_function[i]))
		if (p_function[i] != "-" || p_offsets[i] != "-") {
			if (p_function[i] != "-") {
				line = line sprintf(", \"%s\"", p_function[i])
			} else {
				line = line ", nil"
			}
			if (p_offsets[i] != "-") {
				line = line ", [" gensub_commas(p_offsets[i]) "]"
			} else {
				line = line ", []"
			}
			if (p_function[i] != "-" && p_latest[i] != 1) {
				line = line ", current: false"
			}
		}
		print line "),"
	}
	print "    ]"
	print ""

	# --- referenced by rAthena sources
	referenced_count = 0
	for (i = 1; i <= packet_count; i++) {
		referenced = (hex(p_opcode[i]) in literal_seen)
		# rAthena registers some opcodes by an enumerator (idle_unitType, inventorylistnormalType, ...)
		# that its sending code uses, those are referenced by definition.
		if (p_expression[i] !~ /^(0[xX][0-9a-fA-F]+|[0-9]+)$/) referenced = 1
		if (!referenced) {
			count = split(names_by_opcode[p_opcode[i]], list, " ")
			for (j = 1; j <= count; j++) {
				if (list[j] in header_referenced) referenced = 1
			}
		}
		if (referenced) {
			referenced_opcodes[++referenced_count] = p_opcode[i]
		}
	}
	print "    /// Opcodes rAthena's packet-sending code (clif.cpp, char_clif.cpp, loginclif.cpp, live code at this PACKETVER) uses by"
	print "    /// literal value or HEADER_* name, or that the table registers under an enumerator name. Evidence for \"rAthena can send this\"."
	print "    static let opcodesReferencedBySources: Set<Int> = ["
	line = "       "
	for (i = 1; i <= referenced_count; i++) {
		item = sprintf(" 0x%04x,", referenced_opcodes[i])
		if (length(line item) > 118) {
			print line
			line = "       "
		}
		line = line item
	}
	if (line != "       ") print line
	print "    ]"
	print ""

	# --- name hints for opcodes of the table
	print "    /// Packet names taken from the comments in rAthena's clif.cpp, for opcodes of the table. Labels only."
	print "    static let nameHints: [Int: String] = ["
	for (i = 1; i <= packet_count; i++) {
		if (hex(p_opcode[i]) in hint_by_hex) {
			printf "        0x%04x: \"%s\",\n", p_opcode[i], hint_by_hex[hex(p_opcode[i])]
		}
	}
	print "    ]"
	print ""

	# --- all HEADER_* values
	sort_names(header_names, header_count)
	print "    /// Every HEADER_* constant rAthena defines at PACKETVER " packetver " (src/map/packets.hpp and src/common/packets.hpp)."
	print "    static let headerValues: [String: Int] = ["
	for (i = 1; i <= header_count; i++) {
		printf "        \"%s\": 0x%x,\n", header_names[i], header_value[header_names[i]]
	}
	print "    ]"
	print ""

	# --- HEADER_X constants that have a PACKET_X struct: length of packets that are not in the table
	n = 0
	for (i = 1; i <= header_count; i++) {
		suffix = header_names[i]
		sub(/^HEADER_/, "", suffix)
		if (("PACKET_" suffix) in struct_size) {
			by_opcode[++n] = sprintf("%06d|%s|%d", header_value[header_names[i]], suffix, struct_size["PACKET_" suffix])
		}
	}
	sort_names(by_opcode, n)
	print "    /// (opcode, name, sizeof(PACKET_<name>)) for every HEADER_<name> that has a struct. This is the length of the packet as rAthena"
	print "    /// sends it; for variable length packets it is the fixed part. Most server to client packets are in this list and not in `packets`."
	print "    static let headerStructs: [(opcode: Int, name: String, size: Int)] = ["
	for (i = 1; i <= n; i++) {
		split(by_opcode[i], parts, "|")
		printf "        (0x%04x, \"%s\", %d),\n", parts[1] + 0, parts[2], parts[3]
	}
	print "    ]"
	print ""

	# --- client HEADER_* constants
	sort_names(client_headers, client_header_count)
	print "    /// (name, value the client defines, value rAthena defines or nil when rAthena has no such constant)."
	print "    static let clientHeaders: [(name: String, client: Int, rathena: Int?)] = ["
	for (i = 1; i <= client_header_count; i++) {
		name = client_headers[i]
		if (name in header_value) {
			printf "        (\"%s\", Int(%s), 0x%x),\n", name, name, header_value[name]
		} else {
			printf "        (\"%s\", Int(%s), nil),\n", name, name
		}
	}
	print "    ]"
	print ""

	# --- struct sizes
	sort_names(client_structs, client_struct_count)
	print "    /// (name, `size` the client computes, sizeof() rAthena reports). A client size of -1 means variable length."
	print "    static let structSizes: [(name: String, client: Int, rathena: Int)] = ["
	missing_count = 0
	for (i = 1; i <= client_struct_count; i++) {
		name = client_structs[i]
		if (name in struct_size) {
			printf "        (\"%s\", %s.size, %d),\n", name, name, struct_size[name]
		} else {
			client_only[++missing_count] = name
		}
	}
	print "    ]"
	print ""
	print "    /// Client structs with a `size` that rAthena does not define at this PACKETVER (hand written or for other versions)."
	print "    static let clientOnlyStructs: [String] = ["
	for (i = 1; i <= missing_count; i++) {
		printf "        \"%s\",\n", client_only[i]
	}
	print "    ]"
	print ""

	# --- rAthena struct sizes, for coverage statistics and known-difference checks
	n = 0
	for (name in struct_size) all_structs[++n] = name
	sort_names(all_structs, n)
	print "    /// sizeof() of every struct defined in rAthena's packet headers at PACKETVER " packetver "."
	print "    static let rathenaStructSizes: [String: Int] = ["
	for (i = 1; i <= n; i++) {
		printf "        \"%s\": %d,\n", all_structs[i], struct_size[all_structs[i]]
	}
	print "    ]"
	print ""

	# --- golden blobs
	for (i = 1; i <= blob_count; i++) order[i] = b_name[i]
	sort_names(order, blob_count)
	for (i = 1; i <= blob_count; i++) index_of[b_name[i]] = i
	print "    /// Byte exact packets produced by rAthena's own structs and packing code, hex encoded."
	print "    /// See Tools/packet-golden/dump_*.cpp for the sample values."
	print "    static let blobs: [String: String] = ["
	for (i = 1; i <= blob_count; i++) {
		k = index_of[order[i]]
		printf "        // %s: %s\n", b_name[k], b_layout[k]
		printf "        \"%s\": \"%s\",\n", b_name[k], b_hex[k]
	}
	print "    ]"
	print "}"
}

function gensub_commas(s,    out, n, parts, i) {
	n = split(s, parts, ",")
	out = parts[1]
	for (i = 2; i <= n; i++) out = out ", " parts[i]
	return out
}
